+  RUN OpenQuery(hDocuments,phDocumEst,cWhere,"BY " + phDocumEst:NAME + ".nro-docto BY " + phDocumEst:NAME + ".serie-docto BY " + phDocumEst:NAME + ".nat-operacao").
+  DO WHILE NOT hDocuments:QUERY-OFF-END AND NOT lMatched:
