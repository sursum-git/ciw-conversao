DEFINE VARIABLE n AS INTEGER NO-UNDO.
OUTPUT TO 'compile.log'.
PUT UNFORMATTED 'OpenEdge ' PROVERSION ' NUMDBS=' NUM-DBS SKIP.
IF NOT PROVERSION BEGINS '12.2' OR NUM-DBS<>2 OR NOT CONNECTED('comum') OR NOT CONNECTED('ems5') THEN DO:
 PUT UNFORMATTED 'FAIL ENVIRONMENT' SKIP. OUTPUT CLOSE. QUIT.
END.
COMPILE CurrencyDictionaryReadonlyProbe.p SAVE NO-ERROR.
PUT UNFORMATTED 'ERROR=' COMPILER:ERROR SKIP.
DO n=1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED 'COMPILER_CODE=' ERROR-STATUS:GET-NUMBER(n) SKIP. END.
IF COMPILER:ERROR THEN PUT UNFORMATTED 'FAIL COMPILE' SKIP.
ELSE PUT UNFORMATTED 'PASS COMPILE' SKIP.
OUTPUT CLOSE.
QUIT.
