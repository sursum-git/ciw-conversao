DEFINE VARIABLE n AS INTEGER NO-UNDO.
DEFINE VARIABLE j AS INTEGER NO-UNDO.
DEFINE VARIABLE nameValue AS CHARACTER NO-UNDO.
DEFINE VARIABLE failed AS LOGICAL NO-UNDO.
OUTPUT TO "compile-containers-itens-crud.log".
PUT UNFORMATTED "OpenEdge " PROVERSION SKIP.
DO n=1 TO 2:
 nameValue=ENTRY(n,"ContainersItensCrudService.p,ContainersItensCrudTest.p").
 COMPILE VALUE(nameValue) SAVE NO-ERROR.
 PUT UNFORMATTED nameValue " COMPILER:ERROR=" COMPILER:ERROR SKIP.
 IF COMPILER:ERROR OR ERROR-STATUS:ERROR THEN failed=TRUE.
 DO j=1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP. END.
END.
OUTPUT CLOSE.
IF NOT failed THEN DO n=1 TO 2:
 SESSION:NUMERIC-FORMAT=ENTRY(n,"AMERICAN,EUROPEAN").
 RUN ContainersItensCrudTest.r NO-ERROR.
 OUTPUT TO "compile-containers-itens-crud.log" APPEND.
 IF ERROR-STATUS:ERROR THEN DO: failed=TRUE. DO j=1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP. END. END.
 ELSE PUT UNFORMATTED "PASS " SESSION:NUMERIC-FORMAT SKIP.
 OUTPUT CLOSE.
END.
OUTPUT TO "compile-containers-itens-crud.log" APPEND. PUT UNFORMATTED (IF failed THEN "FAIL ITEMS" ELSE "PASS ITEMS") SKIP. OUTPUT CLOSE. QUIT.
