/* Fixture runner. Never publish local12.8 compiled artifacts. */
DEFINE VARIABLE i AS INTEGER NO-UNDO.
DEFINE VARIABLE j AS INTEGER NO-UNDO.
DEFINE VARIABLE cFile AS CHARACTER NO-UNDO.
DEFINE VARIABLE lFailed AS LOGICAL NO-UNDO.
OUTPUT TO "compile-container-payment-totals.log".
PUT UNFORMATTED "OpenEdge " PROVERSION SKIP.
DO i=1 TO 2:
  cFile=ENTRY(i,"ContainersPagamentoTotalsTest.p,ContainersPagamentoTotalsService.p").
  IF SEARCH(cFile)=? THEN NEXT.
  COMPILE VALUE(cFile) SAVE NO-ERROR.
  PUT UNFORMATTED cFile " COMPILER:ERROR=" COMPILER:ERROR SKIP.
  IF COMPILER:ERROR OR ERROR-STATUS:ERROR THEN lFailed=TRUE.
  DO j=1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP. END.
END.
OUTPUT CLOSE.
IF NOT lFailed THEN DO i=1 TO 2:
  SESSION:NUMERIC-FORMAT=ENTRY(i,"AMERICAN,EUROPEAN").
  RUN ContainersPagamentoTotalsTest.p NO-ERROR.
  OUTPUT TO "compile-container-payment-totals.log" APPEND.
  IF ERROR-STATUS:ERROR THEN DO:
    lFailed=TRUE.
    DO j=1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP. END.
  END.
  ELSE PUT UNFORMATTED "PASS NUMERIC-FORMAT=" SESSION:NUMERIC-FORMAT SKIP.
  OUTPUT CLOSE.
END.
OUTPUT TO "compile-container-payment-totals.log" APPEND.
PUT UNFORMATTED (IF lFailed THEN "FAIL PAYMENT TOTALS" ELSE "PASS PAYMENT TOTALS") SKIP.
OUTPUT CLOSE.
QUIT.
