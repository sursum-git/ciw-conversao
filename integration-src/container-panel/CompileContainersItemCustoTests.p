DEFINE VARIABLE i AS INTEGER NO-UNDO.
DEFINE VARIABLE j AS INTEGER NO-UNDO.
DEFINE VARIABLE c AS CHARACTER NO-UNDO.
DEFINE VARIABLE failed AS LOGICAL NO-UNDO.
OUTPUT TO "compile-containers-item-custo.log". PUT UNFORMATTED "OpenEdge " PROVERSION SKIP.
DO i=1 TO 2:
 c=ENTRY(i,"ContainersItemCustoCalculatorTest.p,ContainersItemCustoCalculator.p").
 IF SEARCH(c)=? THEN DO: PUT UNFORMATTED "MISSING " c SKIP. NEXT. END.
 COMPILE VALUE(c) SAVE NO-ERROR. PUT UNFORMATTED c " COMPILER:ERROR=" COMPILER:ERROR SKIP.
 IF COMPILER:ERROR OR ERROR-STATUS:ERROR THEN failed=TRUE.
 DO j=1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP. END.
END.
OUTPUT CLOSE.
IF NOT failed THEN DO i=1 TO 2:
 SESSION:NUMERIC-FORMAT=ENTRY(i,"AMERICAN,EUROPEAN"). RUN ContainersItemCustoCalculatorTest.p NO-ERROR.
 OUTPUT TO "compile-containers-item-custo.log" APPEND.
 IF ERROR-STATUS:ERROR THEN DO: failed=TRUE. DO j=1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP. END. END.
 ELSE PUT UNFORMATTED "PASS " SESSION:NUMERIC-FORMAT SKIP. OUTPUT CLOSE.
END.
OUTPUT TO "compile-containers-item-custo.log" APPEND. PUT UNFORMATTED (IF failed THEN "FAIL ITEM CUSTO" ELSE "PASS ITEM CUSTO") SKIP. OUTPUT CLOSE.
QUIT.
