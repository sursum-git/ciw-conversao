DEFINE VARIABLE i AS INTEGER NO-UNDO.
DEFINE VARIABLE j AS INTEGER NO-UNDO.
DEFINE VARIABLE failed AS LOGICAL NO-UNDO.
OUTPUT TO "compile-containers-version-context.log".
PUT UNFORMATTED "OpenEdge " PROVERSION SKIP.
COMPILE ContainersVersionContextTest.p SAVE NO-ERROR.
PUT UNFORMATTED "ContainersVersionContextTest.p COMPILER:ERROR=" COMPILER:ERROR SKIP.
IF COMPILER:ERROR OR ERROR-STATUS:ERROR THEN failed=TRUE.
DO j=1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP. END.
OUTPUT CLOSE.
IF NOT failed THEN DO i=1 TO 2:
 SESSION:NUMERIC-FORMAT=ENTRY(i,"AMERICAN,EUROPEAN"). RUN ContainersVersionContextTest.p NO-ERROR.
 OUTPUT TO "compile-containers-version-context.log" APPEND.
 IF ERROR-STATUS:ERROR THEN DO: failed=TRUE. DO j=1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP. END. END.
 ELSE PUT UNFORMATTED "PASS " SESSION:NUMERIC-FORMAT SKIP. OUTPUT CLOSE.
END.
OUTPUT TO "compile-containers-version-context.log" APPEND. PUT UNFORMATTED (IF failed THEN "FAIL CONTEXT" ELSE "PASS CONTEXT") SKIP. OUTPUT CLOSE. QUIT.
