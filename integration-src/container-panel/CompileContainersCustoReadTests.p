DEFINE VARIABLE i AS INTEGER NO-UNDO.
DEFINE VARIABLE j AS INTEGER NO-UNDO.
DEFINE VARIABLE c AS CHARACTER NO-UNDO.
DEFINE VARIABLE lFailed AS LOGICAL NO-UNDO.
OUTPUT TO "compile-containers-custo-read.log".
PUT UNFORMATTED "OpenEdge " PROVERSION SKIP.
DO i=1 TO 4:
 c=ENTRY(i,"ContainersCustoReadTest.p,ContainersCustoReadService.p,ContainersCustoCalculator.p,ContainersCustoCalculatorTest.p").
 IF SEARCH(c)=? THEN NEXT.
 COMPILE VALUE(c) SAVE NO-ERROR.
 PUT UNFORMATTED c " COMPILER:ERROR=" COMPILER:ERROR SKIP.
 IF COMPILER:ERROR OR ERROR-STATUS:ERROR THEN lFailed=TRUE.
 DO j=1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP. END.
END.
OUTPUT CLOSE.
IF NOT lFailed THEN DO i=1 TO 2:
 SESSION:NUMERIC-FORMAT=ENTRY(i,"AMERICAN,EUROPEAN").
 RUN ContainersCustoCalculatorTest.p NO-ERROR.
 IF ERROR-STATUS:ERROR THEN DO:
  lFailed=TRUE.
  OUTPUT TO "compile-containers-custo-read.log" APPEND.
  PUT UNFORMATTED "FAIL MATH " SESSION:NUMERIC-FORMAT SKIP.
  DO j=1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP. END.
  OUTPUT CLOSE.
 END.
 RUN ContainersCustoReadTest.p NO-ERROR.
 OUTPUT TO "compile-containers-custo-read.log" APPEND.
 IF ERROR-STATUS:ERROR THEN DO:
  lFailed=TRUE.
  DO j=1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP. END.
 END.
 ELSE PUT UNFORMATTED "PASS " SESSION:NUMERIC-FORMAT SKIP.
 OUTPUT CLOSE.
END.
OUTPUT TO "compile-containers-custo-read.log" APPEND.
PUT UNFORMATTED (IF lFailed THEN "FAIL CUSTO READ" ELSE "PASS CUSTO READ") SKIP.
OUTPUT CLOSE.
QUIT.
