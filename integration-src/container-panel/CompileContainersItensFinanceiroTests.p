DEFINE VARIABLE i AS INTEGER NO-UNDO.
DEFINE VARIABLE j AS INTEGER NO-UNDO.
DEFINE VARIABLE programName AS CHARACTER NO-UNDO.
DEFINE VARIABLE failed AS LOGICAL NO-UNDO.
OUTPUT TO "compile-containers-itens-financeiro.log". PUT UNFORMATTED "OpenEdge " PROVERSION SKIP.
DO i=1 TO 2:
 programName=ENTRY(i,"ContainersItensFinanceiroTest.p,ContainersItensFinanceiroService.p").
 COMPILE VALUE(programName) SAVE NO-ERROR. PUT UNFORMATTED programName " COMPILER:ERROR=" COMPILER:ERROR SKIP.
 IF COMPILER:ERROR OR ERROR-STATUS:ERROR THEN failed=TRUE.
 DO j=1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP. END.
END. OUTPUT CLOSE.
IF NOT failed THEN DO i=1 TO 2:
 SESSION:NUMERIC-FORMAT=ENTRY(i,"AMERICAN,EUROPEAN"). RUN ContainersItensFinanceiroTest.p NO-ERROR.
 OUTPUT TO "compile-containers-itens-financeiro.log" APPEND.
 IF ERROR-STATUS:ERROR THEN DO: failed=TRUE. DO j=1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP. END. END.
 ELSE PUT UNFORMATTED "PASS " SESSION:NUMERIC-FORMAT SKIP. OUTPUT CLOSE.
END.
OUTPUT TO "compile-containers-itens-financeiro.log" APPEND. PUT UNFORMATTED (IF failed THEN "FAIL ITENS FINANCEIRO" ELSE "PASS ITENS FINANCEIRO") SKIP. OUTPUT CLOSE.
QUIT.
