/* Auxiliary 12.8 or mandatory 12.2 compile. Connected espec fixture only for
   compiling the real IMA include. Tests override it with their own temp-table. */
DEFINE VARIABLE failed AS LOGICAL NO-UNDO.
DEFINE VARIABLE i AS INTEGER NO-UNDO.
DEFINE VARIABLE j AS INTEGER NO-UNDO.
DEFINE VARIABLE sourceFile AS CHARACTER NO-UNDO.
OUTPUT TO "compile-container-custo-boundary.log".
PUT UNFORMATTED "OpenEdge " PROVERSION SKIP.
DO i=1 TO 2:
 sourceFile=ENTRY(i,"ContainersCustoBoundaryTest.p,ContainersCustoRead.p").
 COMPILE VALUE(sourceFile) SAVE NO-ERROR.
 PUT UNFORMATTED sourceFile " COMPILER:ERROR=" COMPILER:ERROR SKIP.
 IF COMPILER:ERROR OR ERROR-STATUS:ERROR THEN failed=TRUE.
 DO j=1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP. END.
END.
OUTPUT CLOSE.
IF NOT failed THEN DO i=1 TO 2:
 SESSION:NUMERIC-FORMAT=ENTRY(i,"AMERICAN,EUROPEAN").
 RUN ContainersCustoBoundaryTest.p NO-ERROR.
 OUTPUT TO "compile-container-custo-boundary.log" APPEND.
 IF ERROR-STATUS:ERROR THEN DO:
  failed=TRUE.
  DO j=1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP. END.
 END.
 ELSE PUT UNFORMATTED "PASS NUMERIC-FORMAT=" SESSION:NUMERIC-FORMAT SKIP.
 OUTPUT CLOSE.
END.
OUTPUT TO "compile-container-custo-boundary.log" APPEND.
PUT UNFORMATTED (IF failed THEN "FAIL CUSTO BOUNDARY" ELSE "PASS CUSTO BOUNDARY") SKIP.
OUTPUT CLOSE.
QUIT.
