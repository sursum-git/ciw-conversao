DEFINE VARIABLE failed AS LOGICAL NO-UNDO.
DEFINE VARIABLE i AS INTEGER NO-UNDO.
DEFINE VARIABLE j AS INTEGER NO-UNDO.
DEFINE VARIABLE n AS INTEGER NO-UNDO.
DEFINE VARIABLE name AS CHARACTER NO-UNDO.
OUTPUT TO "compile-containers-versao-cost.log".
PUT UNFORMATTED "OpenEdge " PROVERSION SKIP.
DO i=1 TO 6:
 name=ENTRY(i,"ContainersCustoCalculator.p,ContainersCustoCalculatorTest.p,ContainersCustoReadService.p,ContainersCustoReadTest.p,ContainersVersaoCostAdapter.p,ContainersVersaoCostAdapterTest.p").
 COMPILE VALUE(name) SAVE NO-ERROR.
 PUT UNFORMATTED name " COMPILER:ERROR=" COMPILER:ERROR SKIP.
 IF COMPILER:ERROR OR ERROR-STATUS:ERROR THEN failed=TRUE.
 DO j=1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP. END.
END.
OUTPUT CLOSE.
IF NOT failed THEN DO n=1 TO 2:
 SESSION:NUMERIC-FORMAT=ENTRY(n,"AMERICAN,EUROPEAN").
 DO i=1 TO 3:
  name=ENTRY(i,"ContainersCustoCalculatorTest.p,ContainersCustoReadTest.p,ContainersVersaoCostAdapterTest.p").
  RUN VALUE(name) NO-ERROR.
  OUTPUT TO "compile-containers-versao-cost.log" APPEND.
  IF ERROR-STATUS:ERROR THEN DO:
   failed=TRUE. DO j=1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP. END.
  END.
  ELSE PUT UNFORMATTED "PASS " name " " SESSION:NUMERIC-FORMAT SKIP.
  OUTPUT CLOSE.
 END.
END.
OUTPUT TO "compile-containers-versao-cost.log" APPEND.
PUT UNFORMATTED (IF failed THEN "FAIL VERSION COST" ELSE "PASS VERSION COST") SKIP. OUTPUT CLOSE.
QUIT.
