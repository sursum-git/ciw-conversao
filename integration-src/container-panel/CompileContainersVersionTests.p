DEFINE VARIABLE i AS INTEGER NO-UNDO.
DEFINE VARIABLE j AS INTEGER NO-UNDO.
DEFINE VARIABLE fileValue AS CHARACTER NO-UNDO.
DEFINE VARIABLE failedValue AS LOGICAL NO-UNDO.
OUTPUT TO "compile-containers-version.log".
PUT UNFORMATTED "OpenEdge " PROVERSION SKIP.
DO i=1 TO 3:
 fileValue=ENTRY(i,"ContainersVersionFixture.p,ContainersVersionService.p,ContainersVersionTest.p").
 COMPILE VALUE(fileValue) SAVE NO-ERROR.
 PUT UNFORMATTED fileValue " COMPILER:ERROR=" COMPILER:ERROR SKIP.
 IF COMPILER:ERROR OR ERROR-STATUS:ERROR THEN failedValue=TRUE.
 DO j=1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP. END.
END.
OUTPUT CLOSE.
IF NOT failedValue THEN DO i=1 TO 2:
 SESSION:NUMERIC-FORMAT=ENTRY(i,"AMERICAN,EUROPEAN").
 RUN ContainersVersionTest.p NO-ERROR.
 OUTPUT TO "compile-containers-version.log" APPEND.
 IF ERROR-STATUS:ERROR THEN DO:
  failedValue=TRUE.
  DO j=1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP. END.
 END.
 ELSE PUT UNFORMATTED "PASS " SESSION:NUMERIC-FORMAT SKIP.
 OUTPUT CLOSE.
END.
OUTPUT TO "compile-containers-version.log" APPEND.
PUT UNFORMATTED (IF failedValue THEN "FAIL VERSION" ELSE "PASS VERSION") SKIP.
OUTPUT CLOSE.
QUIT.
