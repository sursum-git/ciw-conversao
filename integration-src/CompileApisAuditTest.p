/* Runner isolado: apenas temp-tables, nunca publicar no PASOE. */
DEFINE VARIABLE cSource AS CHARACTER NO-UNDO.
DEFINE VARIABLE i AS INTEGER NO-UNDO.
DEFINE VARIABLE j AS INTEGER NO-UNDO.
DEFINE VARIABLE lFailed AS LOGICAL NO-UNDO.
SESSION:NUMERIC-FORMAT = ENTRY(2, SESSION:PARAMETER).
OUTPUT TO "compile-apis-audit.log".
PUT UNFORMATTED "OpenEdge " PROVERSION " NUMERIC-FORMAT=" SESSION:NUMERIC-FORMAT SKIP.
DO i = 1 TO 4:
  cSource = ENTRY(i,"EmpresasCrudService.p,RunEmpresasCrudTests.p,TiposAnexoCrudService.p,TiposAnexoCrudTest.p").
  COMPILE VALUE(cSource) SAVE NO-ERROR.
  PUT UNFORMATTED cSource " COMPILER:ERROR=" COMPILER:ERROR SKIP.
  IF COMPILER:ERROR OR ERROR-STATUS:ERROR THEN lFailed = TRUE.
  DO j = 1 TO ERROR-STATUS:NUM-MESSAGES:
    PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP.
  END.
END.
OUTPUT CLOSE.
IF NOT lFailed THEN RUN VALUE(ENTRY(1, SESSION:PARAMETER)).
QUIT.
