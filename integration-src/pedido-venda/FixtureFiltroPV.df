ADD FIELD "tp-usuario" OF "user-web" AS integer
ADD FIELD "ativo" OF "user-web" AS logical
ADD TABLE "ped-venda"
  AREA "Schema Area"
ADD FIELD "nr-pedido" OF "ped-venda" AS integer
