ADD TABLE "ped-repre"
  AREA "Schema Area"
ADD FIELD "nr-pedido" OF "ped-repre" AS integer
ADD FIELD "nome-ab-rep" OF "ped-repre" AS character
ADD TABLE "repres"
  AREA "Schema Area"
ADD FIELD "cod-rep" OF "repres" AS integer
