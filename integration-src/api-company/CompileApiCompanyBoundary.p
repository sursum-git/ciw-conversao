BLOCK-LEVEL ON ERROR UNDO, THROW.
DEFINE VARIABLE cultureName AS CHARACTER NO-UNDO.
DEFINE VARIABLE testSource AS CHARACTER NO-UNDO.
DEFINE VARIABLE iMessage AS INTEGER NO-UNDO.
DEFINE VARIABLE iCulture AS INTEGER NO-UNDO.
PROPATH=SESSION:PARAMETER + "," + PROPATH.
OUTPUT TO VALUE(SESSION:PARAMETER + "/compile-company.log").
PUT UNFORMATTED "OpenEdge " PROVERSION SKIP.
testSource=SESSION:PARAMETER + "/ApiCompanyBoundaryTest.p".
COMPILE VALUE(testSource) SAVE NO-ERROR.
PUT UNFORMATTED "COMPILER:ERROR=" STRING(COMPILER:ERROR,"yes/no") SKIP.
IF COMPILER:ERROR THEN DO:
 DO iMessage=1 TO ERROR-STATUS:NUM-MESSAGES:
  PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(iMessage) SKIP.
 END.
 OUTPUT CLOSE. QUIT.
END.
DO iCulture=1 TO 2:
 cultureName=ENTRY(iCulture,"AMERICAN,EUROPEAN").
 SESSION:NUMERIC-FORMAT=cultureName.
 PUT UNFORMATTED "Culture=" cultureName SKIP.
 DO ON ERROR UNDO, THROW:
  RUN VALUE(SESSION:PARAMETER + "/ApiCompanyBoundaryTest.r").
  CATCH err AS Progress.Lang.Error:
   PUT UNFORMATTED "FAIL runtime: " err:GetMessage(1) SKIP.
   OUTPUT CLOSE. QUIT.
  END CATCH.
 END.
END.
OUTPUT CLOSE.
QUIT.
