DEFINE VARIABLE n AS INTEGER NO-UNDO.
DEFINE VARIABLE j AS INTEGER NO-UNDO.
DEFINE VARIABLE files AS CHARACTER NO-UNDO INITIAL "CiwReferenciasService.p,CiwCadastrosCrud.p,CiwReferenciasTest.p".
OUTPUT TO "compile-ciw-referencias.log".
PUT UNFORMATTED "OpenEdge " PROVERSION SKIP.
DO n=1 TO NUM-ENTRIES(files):
 COMPILE VALUE(ENTRY(n,files)) SAVE NO-ERROR.
 PUT UNFORMATTED ENTRY(n,files) " COMPILER:ERROR=" COMPILER:ERROR SKIP.
 DO j=1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP. END.
END.
OUTPUT CLOSE.
QUIT.
