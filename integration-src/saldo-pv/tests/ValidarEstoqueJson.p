DEFINE VARIABLE i AS INTEGER NO-UNDO.
DEFINE VARIABLE j AS INTEGER NO-UNDO.
DEFINE VARIABLE failed AS LOGICAL NO-UNDO.
IF NUM-DBS <> 1 OR INDEX(PDBNAME(1), "saldo-pv-fixture") = 0 THEN QUIT.
CREATE ALIAS ems2med FOR DATABASE saldofixture.
CREATE ALIAS ems2cad FOR DATABASE saldofixture.
CREATE ALIAS espec FOR DATABASE saldofixture.
OUTPUT TO "estoque-json-validation.log".
PUT UNFORMATTED "OpenEdge " PROVERSION SKIP.
COMPILE tests/TestEstoqueJson.p NO-ERROR.
failed = COMPILER:ERROR OR ERROR-STATUS:ERROR.
DO j = 1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP. END.
OUTPUT CLOSE.
IF NOT failed THEN DO i = 1 TO 2:
 SESSION:NUMERIC-FORMAT = ENTRY(i,"AMERICAN,EUROPEAN").
 RUN tests/TestEstoqueJson.p NO-ERROR.
 OUTPUT TO "estoque-json-validation.log" APPEND.
 IF ERROR-STATUS:ERROR THEN DO:
  failed = TRUE.
  DO j = 1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP. END.
 END.
 IF CAN-FIND(FIRST espec.user-web) OR CAN-FIND(FIRST ems2cad.repres)
  OR CAN-FIND(FIRST ems2med.item) OR CAN-FIND(FIRST espec.pp-container)
  OR CAN-FIND(FIRST ems2med.saldo-estoq) OR CAN-FIND(FIRST espec.pp-it-container) THEN DO:
  failed = TRUE. PUT UNFORMATTED "FAIL fixture nao limpa" SKIP.
 END.
 ELSE PUT UNFORMATTED "CLEAN " SESSION:NUMERIC-FORMAT SKIP.
 OUTPUT CLOSE.
 IF failed THEN LEAVE.
END.
OUTPUT TO "estoque-json-validation.log" APPEND.
PUT UNFORMATTED (IF failed THEN "FAIL" ELSE "PASS") SKIP.
OUTPUT CLOSE.
QUIT.
