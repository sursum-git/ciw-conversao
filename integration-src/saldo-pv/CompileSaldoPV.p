/* Compila contra o schema real sem executar a consulta ou testes de negocio. */
DEFINE VARIABLE i AS INTEGER NO-UNDO.
OUTPUT TO "saldo-compile.log".
PUT UNFORMATTED "OpenEdge " PROVERSION SKIP.
COMPILE esbo/boSaldoPV.p SAVE XREF "saldo-compile.xref" NO-ERROR.
PUT UNFORMATTED "COMPILER:ERROR=" COMPILER:ERROR SKIP.
DO i = 1 TO ERROR-STATUS:NUM-MESSAGES:
    PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(i) SKIP.
END.
PUT UNFORMATTED (IF COMPILER:ERROR OR ERROR-STATUS:ERROR THEN "FAIL" ELSE "PASS") SKIP.
OUTPUT CLOSE.
QUIT.
